<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- What Hop needs under the hardened runtime, which notarization requires. Screen
     Recording, Accessibility and running other programs (claude, git, gh) need none. -->
<dict>
	<!-- Toggle Dark Mode (System Events) and Restart/Shut Down/Log Out (loginwindow). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Asking Ask Claude out loud. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
